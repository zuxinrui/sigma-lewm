# Trinity-MI paper style (ICLR single column, text width 5.5 in)
font.family: monospace
font.monospace: DejaVu Sans Mono, Liberation Mono, Courier New
font.sans-serif: Nimbus Sans, Liberation Sans, DejaVu Sans, Arial
font.size: 7.5
axes.titlesize: 8
axes.labelsize: 7.5
xtick.labelsize: 7
ytick.labelsize: 7
legend.fontsize: 7
mathtext.fontset: dejavusans
mathtext.default: regular
axes.unicode_minus: False
axes.edgecolor: 9CA3AF
axes.linewidth: 0.6
axes.spines.top: False
axes.spines.right: False
axes.grid: True
axes.grid.axis: y
grid.color: E5E7EB
grid.linewidth: 0.5
grid.linestyle: -
axes.axisbelow: True
axes.titleweight: normal
axes.titlelocation: left
axes.prop_cycle: cycler('color', ['0F766E', '4B5563', '2F7ED8', '9CA3AF', '7857C5', 'E45756'])
xtick.major.size: 2.5
ytick.major.size: 2.5
xtick.major.width: 0.6
ytick.major.width: 0.6
xtick.color: 4B5563
ytick.color: 4B5563
xtick.labelcolor: 182230
ytick.labelcolor: 182230
axes.labelcolor: 182230
text.color: 182230
lines.linewidth: 1.3
lines.markersize: 3.6
lines.markeredgewidth: 0.8
errorbar.capsize: 1.5
legend.frameon: False
legend.handlelength: 1.4
figure.dpi: 120
savefig.dpi: 300
savefig.bbox: tight
savefig.pad_inches: 0.02
pdf.fonttype: 42
ps.fonttype: 42
svg.fonttype: none
